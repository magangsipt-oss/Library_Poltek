{
  "name": "library-poltek-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API portal perpustakaan Politeknik Sinar Mas Berau Coal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/init-db.js",
    "db:start": "bash ../database/postgres-local.sh start",
    "db:stop": "bash ../database/postgres-local.sh stop",
    "db:status": "bash ../database/postgres-local.sh status",
    "db:migrate": "node scripts/migrate-db.js",
    "test:database": "node --test tests/database-migration.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
